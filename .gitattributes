# Normalize text to LF in the repository; Windows scripts stay CRLF in the
# working tree so cmd.exe and PowerShell keep working on checkout.
* text=auto

*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary assets
*.wav         binary
*.mp3         binary
*.gguf        binary
*.safetensors binary
*.bin         binary
*.png         binary
*.jpg         binary
*.ico         binary
*.exe         binary
*.dll         binary
